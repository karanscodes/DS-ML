        "# useful decorator?\n",
        "# we'll make a decorator that'll print the execution time for a decorator\n",
        "\n",
        "import time\n",
        "\n",
        "def timer(func):\n",
        "  def wrapper():\n",
        "    start = time.time()\n",
        "    func()\n",
        "    print(\"time taken by function\", func.__name__, 'is', time.time() - start, 'seconds')\n",
        "  return wrapper\n",
        "\n",
        "def hello():\n",
        "  print(\"hello\")\n",
        "  time.sleep(2)\n",
        "\n",
        "# shorthand use kar rha hu yahan\n",
        "@timer\n",
        "def display():\n",
        "  print(\"I display shit\")\n",
        "  time.sleep(1)\n",
        "\n",
        "f = timer(hello)\n",
        "f()\n",
        "display()"
